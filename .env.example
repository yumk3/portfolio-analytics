# ---------------------------------------------------------------
# Template. Safe to commit - placeholder values only.
# Copy to .env (gitignored) and put real values there.
# ---------------------------------------------------------------

# SnapTrade API credentials (Personal API key flow)
SNAPTRADE_CLIENT_ID=your-snaptrade-client-id
SNAPTRADE_CONSUMER_KEY=your-snaptrade-consumer-key
# Not used by the Personal flow (the API key identifies you); keep for completeness
SNAPTRADE_USER_ID=your-snaptrade-user-id
SNAPTRADE_USER_SECRET=your-snaptrade-user-secret

# Local DuckDB database (relative to the project root, or absolute)
DB_PATH=data/portfolio.duckdb

# Optional one-run switches, normally left unset:
# SNAPTRADE_DRY_RUN=1                fetch and save raw files, write nothing
# SNAPTRADE_ALLOW_POSITION_DROP=1    accept a genuine large sell-off
# RETURNS_BROKER_CSV=path\to\file.csv       test file for validate_returns.py check 3a
# RETURNS_STATEMENT_CSV=path\to\file.csv    test file for validate_returns.py check 3b
